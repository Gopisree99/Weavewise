# ==============================================================================
# WeaveWise AI — Production & Development Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel)
# ------------------------------------------------------------------------------
# Set this in your Vercel Dashboard -> Settings -> Environment Variables
# In production, point to your deployed Render FastAPI service:
VITE_API_BASE_URL=https://your-weavewise-backend.onrender.com

# For local development with Vite proxy, leave empty or set to http://127.0.0.1:8000:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (FastAPI / Render)
# ------------------------------------------------------------------------------
# Server Network Settings
PORT=8000
TRYON_PORT=8000
TRYON_HOST=0.0.0.0
TRYON_DEBUG=False

# Allowed CORS Origins (Comma-separated list of allowed frontend origins)
# In production, set to your Vercel production domain:
CORS_ORIGINS=https://weavewise-ai.vercel.app,http://localhost:5173,http://localhost:3000

# Hugging Face Spaces Cloud GPU Credentials (for genuine IDM-VTON ZeroGPU inference)
# Obtain a free token from https://huggingface.co/settings/tokens (Read role)
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Cloud GPU Model & Space Configuration
TRYON_CLOUD_PROVIDER=huggingface
TRYON_MODEL=IDM-VTON
TRYON_CLOUD_SPACE=yisol/IDM-VTON
TRYON_SECONDARY_CLOUD_SPACE=multimodalart/CatVTON-zerogpu
TRYON_CLOUD_TIMEOUT=120

# ------------------------------------------------------------------------------
# 3. OPTIONAL AI FASHION DESIGN ADVISOR PROVIDERS
# ------------------------------------------------------------------------------
AI_IMAGE_PROVIDER=pollinations
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_API_KEY=
STABILITY_API_KEY=
